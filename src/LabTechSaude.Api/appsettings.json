{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimitConfig": {
    "IpRequisicoesPorMinuto": 5,
    "EnvioCodigoCooldownSegundos": 60,
    "EnvioCodigoMaximoPorHora": 5,
    "EnvioCodigoBloqueioMinutos": 60,
    "ConfirmacaoCodigoMaximoFalhas": 5,
    "ConfirmacaoCodigoJanelaMinutos": 15,
    "ConfirmacaoCodigoBloqueioMinutos": 15
  }
}
